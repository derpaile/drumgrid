{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.metronomm.invalid/reviewed-drum-patterns-v1.schema.json",
  "title": "Reviewed drum pattern catalog",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "updated", "count", "patterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "count": { "type": "integer", "minimum": 1 },
    "excludedDuplicates": { "type": "object", "additionalProperties": { "type": "string" } },
    "review": { "type": "object" },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/definitions/pattern" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "hit": { "enum": ["mute", "ghost", "normal", "accent"] },
    "track": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/hit" } },
    "pattern": {
      "type": "object",
      "required": ["id", "name", "category", "bpmMin", "bpmMax", "meter", "subdivision", "bars", "grouping", "tempoUnit", "pattern", "drumTracks", "difficulty", "instruction", "drumOnly", "attribution", "learningGoals", "whyInteresting", "playback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "bpmMin": { "type": "number", "exclusiveMinimum": 0 },
        "bpmMax": { "type": "number", "exclusiveMinimum": 0 },
        "meter": { "type": "string", "pattern": "^[1-9][0-9]*/(?:2|4|8|16)$" },
        "subdivision": { "enum": ["Viertel", "Achtel", "16tel", "Triolen", "Sextolen"] },
        "bars": { "type": "integer", "minimum": 1 },
        "grouping": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "tempoUnit": { "enum": ["quarter", "eighth", "dotted-quarter"] },
        "pattern": { "$ref": "#/definitions/track" },
        "drumTracks": {
          "type": "object",
          "propertyNames": { "enum": ["kick", "snare", "closedHat", "openHat", "ride", "crash", "rim", "highTom", "lowTom"] },
          "additionalProperties": { "$ref": "#/definitions/track" }
        },
        "difficulty": { "enum": ["Leicht", "Mittel", "Fortgeschritten"] },
        "instruction": { "type": "string", "minLength": 1 },
        "drumOnly": { "const": true },
        "attribution": { "type": "string", "minLength": 1 },
        "learningGoals": { "type": "array", "items": { "type": "string" } },
        "whyInteresting": { "type": "string", "minLength": 1 },
        "playback": {
          "type": "object",
          "required": ["bpm"],
          "properties": {
            "bpm": { "type": "number", "exclusiveMinimum": 0 },
            "swing": { "type": "number", "minimum": 50, "maximum": 75 },
            "kit": { "enum": ["Studio", "Trocken", "Elektronisch"] }
          },
          "additionalProperties": true
        },
        "source": {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        },
        "originalFeel": {
          "type": "object",
          "required": ["label", "note", "sourceBpm"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 },
            "sourceBpm": { "type": "number", "exclusiveMinimum": 0 },
            "timingMs": { "$ref": "#/definitions/perHitValues" },
            "velocityMultipliers": { "$ref": "#/definitions/perHitValues" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "perHitValues": {
      "type": "object",
      "propertyNames": { "enum": ["kick", "snare", "closedHat", "openHat", "ride", "crash", "rim", "highTom", "lowTom"] },
      "additionalProperties": {
        "type": "object",
        "patternProperties": { "^[0-9]+$": { "type": "number" } },
        "additionalProperties": false
      }
    }
  }
}
